<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the INTERNET permission is required (BLE is simulated over HTTP on port 8001). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        PROTOTYPE ONLY: android:usesCleartextTraffic="true" is enabled so the app can talk to the
        local Spring Boot backend (port 8080) and Python hardware simulator (port 8001) over plain
        HTTP during local development. Disable cleartext HTTP and use HTTPS in production.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kilowhat"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kilowhat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
